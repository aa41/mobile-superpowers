#!/usr/bin/env bash
# SessionStart hook for mobile-superpowers.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

skill_path="${PLUGIN_ROOT}/skills/using-mobile-superpowers/SKILL.md"
using_mobile_content="$(cat "$skill_path" 2>&1 || echo "Error reading using-mobile-superpowers skill")"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_mobile_escaped="$(escape_for_json "$using_mobile_content")"
session_context="<EXTREMELY_IMPORTANT>\nYou have Mobile Superpowers.\n\n**Below is the full content of your 'mobile-superpowers:using-mobile-superpowers' skill. For all other skills, use the Skill tool:**\n\n${using_mobile_escaped}\n</EXTREMELY_IMPORTANT>"
session_context_escaped="$(escape_for_json "$session_context")"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context_escaped"

exit 0
